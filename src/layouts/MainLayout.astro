---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "aDehghan — Developer & Digital Creator",
  description = "Personal portfolio of aDehghan. Exploring technology and building digital experiences."
} = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090d" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Vazirmatn:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (() => {
        try {
          const language = localStorage.getItem("adehghan-language") || "en";
          const theme = localStorage.getItem("adehghan-theme") || "dark";

          document.documentElement.lang = language;
          document.documentElement.dir = language === "fa" ? "rtl" : "ltr";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.lang = "en";
          document.documentElement.dir = "ltr";
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  const root = document.documentElement;

  const applyLanguage = (language: string) => {
    const nextLanguage = language === "fa" ? "fa" : "en";

    root.lang = nextLanguage;
    root.dir = nextLanguage === "fa" ? "rtl" : "ltr";

    try {
      localStorage.setItem("adehghan-language", nextLanguage);
    } catch {
      // The preference still applies for the current page.
    }

    document.dispatchEvent(
      new CustomEvent("site-language-change", {
        detail: { language: nextLanguage },
      })
    );

    updatePreferenceControls();
  };

  const applyTheme = (theme: string) => {
    const nextTheme = theme === "light" ? "light" : "dark";

    root.dataset.theme = nextTheme;

    try {
      localStorage.setItem("adehghan-theme", nextTheme);
    } catch {
      // The preference still applies for the current page.
    }

    updatePreferenceControls();
  };

  const updatePreferenceControls = () => {
    const language = root.lang;
    const theme = root.dataset.theme;

    document.querySelectorAll<HTMLButtonElement>("[data-language-toggle]").forEach((button) => {
      button.textContent = language === "en" ? "FA" : "EN";
      button.setAttribute(
        "aria-label",
        language === "en" ? "Switch language to Persian" : "Switch language to English"
      );
    });

    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      button.textContent = theme === "dark" ? "☼" : "☾";
      button.setAttribute(
        "aria-label",
        theme === "dark" ? "Switch to light theme" : "Switch to dark theme"
      );
      button.setAttribute("aria-pressed", String(theme === "light"));
    });
  };

  document.querySelectorAll<HTMLButtonElement>("[data-language-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      applyLanguage(root.lang === "en" ? "fa" : "en");
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      applyTheme(root.dataset.theme === "dark" ? "light" : "dark");
    });
  });

  updatePreferenceControls();
</script>


