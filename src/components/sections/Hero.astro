<script>
  import { gsap } from "gsap";

  const media = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!media.matches) {
    const elements = gsap.utils.toArray<HTMLElement>(".hero-animate");

    gsap.fromTo(
      elements,
      { y: 28, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        stagger: 0.13,
        ease: "power3.out",
        delay: 0.15,
      }
    );

    gsap.to(".visual-orbit", {
      rotate: 360,
      duration: 45,
      repeat: -1,
      ease: "none",
      transformOrigin: "center center",
    });

    gsap.to(".hero-glow-purple", {
      x: 25,
      y: -20,
      duration: 5,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
    });
  }
</script>
